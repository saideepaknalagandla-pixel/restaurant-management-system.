<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Checkout | Fork & Flame</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/style.css"></head><body><nav class="nav"><a class="brand" href="<%=request.getContextPath()%>/">Fork<span>&</span>Flame</a><div><a href="<%=request.getContextPath()%>/menu">Menu</a><a href="<%=request.getContextPath()%>/cart">Cart</a></div></nav><main class="page narrow"><p class="eyebrow">FINAL STEP</p><h1>Checkout<span class="dot">.</span></h1><div class="panel"><%if(request.getAttribute("error")!=null){%><p class="error"><%=request.getAttribute("error")%></p><%}%><form class="checkout-form" method="post" action="<%=request.getContextPath()%>/checkout"><label for="name">Your name</label><input id="name" name="name" maxlength="100" required placeholder="e.g. Sai Deepak"><label for="email">Email address</label><input id="email" type="email" name="email" maxlength="150" required placeholder="you@example.com"><p class="muted">This demo records your order in the local database. Online payment is not enabled.</p><button class="btn full" type="submit">Place order →</button></form></div></main><footer>Thank you for choosing Fork & Flame.</footer></body></html>