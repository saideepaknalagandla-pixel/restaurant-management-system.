<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*" %><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Admin | Fork & Flame</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/style.css"></head><body><nav class="nav"><a class="brand" href="<%=request.getContextPath()%>/">Fork<span>&</span>Flame</a><div><a href="<%=request.getContextPath()%>/menu">Menu</a><a href="<%=request.getContextPath()%>/cart">Cart</a><a class="active" href="<%=request.getContextPath()%>/admin">Admin</a></div></nav><main class="page"><p class="eyebrow">RESTAURANT CONTROL ROOM</p><h1>Admin dashboard<span class="dot">.</span></h1><p class="lead">Review orders and keep the menu up to date.</p>
<section class="panel admin-section"><h2>Recent orders</h2><div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Email</th><th>Total</th><th>Status</th><th>Update</th></tr></thead><tbody><%List<String[]> orders=(List<String[]>)request.getAttribute("orders");if(orders!=null){for(String[] o:orders){%><tr><td>#<%=o[0]%><br><small><%=o[5]%></small></td><td><%=o[1]%></td><td><%=o[2]%></td><td>₹<%=o[3]%></td><td><span class="status"><%=o[4]%></span></td><td><form class="inline-form" method="post" action="<%=request.getContextPath()%>/admin"><input type="hidden" name="action" value="status"><input type="hidden" name="id" value="<%=o[0]%>"><select name="status" aria-label="Order status"><%for(String s:new String[]{"PLACED","PREPARING","READY","DELIVERED","CANCELLED"}){%><option value="<%=s%>" <%=s.equals(o[4])?"selected":""%>><%=s%></option><%}%></select><button class="btn small" type="submit">Save</button></form></td></tr><%}}%></tbody></table></div><%if(orders==null||orders.isEmpty()){%><p class="muted">No orders yet. Place a test order from the menu.</p><%}%></section>
<section class="panel admin-section"><h2>Add a menu item</h2><form class="admin-form" method="post" action="<%=request.getContextPath()%>/admin"><input type="hidden" name="action" value="add"><label>Name<input name="name" required maxlength="100"></label><label>Category<input name="category" required maxlength="60" placeholder="Main Course"></label><label>Price (₹)<input name="price" type="number" min="0.01" step="0.01" required></label><label>Image URL<input name="imageUrl" type="url" maxlength="500" placeholder="https://..."></label><label class="wide">Description<input name="description" maxlength="255"></label><div><button class="btn" type="submit">Add menu item +</button></div></form></section>
<section class="panel admin-section"><h2>Available menu items</h2><div class="menu-admin-list"><%List<com.restaurant.model.MenuItem> menu=(List<com.restaurant.model.MenuItem>)request.getAttribute("menuItems");if(menu!=null){for(com.restaurant.model.MenuItem m:menu){%><div class="menu-admin-row"><span><strong><%=m.getName()%></strong><small><%=m.getCategory()%> · ₹<%=m.getPrice().toPlainString()%></small></span><form method="post" action="<%=request.getContextPath()%>/admin" onsubmit="return confirm('Hide this item from the customer menu?')"><input type="hidden" name="action" value="hide"><input type="hidden" name="id" value="<%=m.getId()%>"><button class="btn small secondary" type="submit">Hide item</button></form></div><%}}%></div></section>
<p class="warning-note"><strong>Demo note:</strong> This admin page is not protected by login. Add authentication and role-based authorization before deploying it publicly.</p></main><footer>Fork & Flame · Admin dashboard</footer></body></html>