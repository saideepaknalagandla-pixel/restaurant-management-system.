<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,java.math.BigDecimal,com.restaurant.model.CartItem" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Your cart | Fork & Flame</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/style.css"></head><body><nav class="nav"><a class="brand" href="<%=request.getContextPath()%>/">Fork<span>&</span>Flame</a><div><a href="<%=request.getContextPath()%>/menu">Menu</a><a class="active" href="<%=request.getContextPath()%>/cart">Cart</a><a href="<%=request.getContextPath()%>/admin">Admin</a></div></nav>
<main class="page narrow"><p class="eyebrow">ALMOST THERE</p><h1>Your cart<span class="dot">.</span></h1><%Collection<CartItem> cart=(Collection<CartItem>)request.getAttribute("cart"); if(cart==null||cart.isEmpty()){%><div class="empty"><h2>Your cart is hungry.</h2><p>Add something delicious from our menu.</p><a class="btn" href="<%=request.getContextPath()%>/menu">Browse menu →</a></div><%}else{%>
<div class="panel"><%for(CartItem ci:cart){%><div class="cart-row"><div class="cart-name"><h3><%=ci.getItem().getName()%></h3><p>₹<%=ci.getItem().getPrice().toPlainString()%> each</p></div><form class="qty-form" method="post" action="<%=request.getContextPath()%>/cart"><input type="hidden" name="action" value="update"><input type="hidden" name="id" value="<%=ci.getItem().getId()%>"><input type="number" name="quantity" min="0" max="50" value="<%=ci.getQuantity()%>" aria-label="Quantity"><button class="btn small secondary" type="submit">Update</button></form><strong>₹<%=ci.getSubtotal().toPlainString()%></strong><form method="post" action="<%=request.getContextPath()%>/cart"><input type="hidden" name="action" value="remove"><input type="hidden" name="id" value="<%=ci.getItem().getId()%>"><button class="remove" type="submit">Remove</button></form></div><%}%><div class="total-row"><span>Total</span><strong>₹<%=request.getAttribute("total")%></strong></div><a class="btn full" href="<%=request.getContextPath()%>/checkout">Continue to checkout →</a></div><%}%></main><footer>Need something else? <a href="<%=request.getContextPath()%>/menu">Back to menu</a></footer></body></html>