<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,com.restaurant.model.MenuItem" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Menu | Fork & Flame</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/style.css"></head><body>
<nav class="nav"><a class="brand" href="<%=request.getContextPath()%>/">Fork<span>&</span>Flame</a><div><a class="active" href="<%=request.getContextPath()%>/menu">Menu</a><a href="<%=request.getContextPath()%>/cart">Cart</a><a href="<%=request.getContextPath()%>/admin">Admin</a></div></nav>
<main class="page"><p class="eyebrow">MADE WITH CARE</p><h1>Our menu<span class="dot">.</span></h1><p class="lead">A little something for every craving.</p><div class="menu-grid">
<% List<MenuItem> items=(List<MenuItem>)request.getAttribute("menuItems"); if(items!=null&&!items.isEmpty()){for(MenuItem item:items){%>
<article class="food-card"><img src="<%=item.getImageUrl()==null||item.getImageUrl().isBlank()?"https://images.unsplash.com/photo-1546549032-9571cd6b27df?auto=format&fit=crop&w=900&q=80":item.getImageUrl()%>" alt="<%=item.getName()%>" loading="lazy"><div class="food-info"><span class="tag"><%=item.getCategory()%></span><h3><%=item.getName()%></h3><p><%=item.getDescription()==null?"Freshly prepared":item.getDescription()%></p><div class="food-bottom"><strong>₹<%=item.getPrice().toPlainString()%></strong><form method="post" action="<%=request.getContextPath()%>/cart/add"><input type="hidden" name="id" value="<%=item.getId()%>"><button class="btn small" type="submit">Add +</button></form></div></div></article>
<%}}else{%><p>No menu items are available yet.</p><%}%></div></main><footer>Freshly prepared, just for you.</footer></body></html>